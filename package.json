{
  "name": "sport-rent-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "type-check": "tsc --noEmit",
    "api:generate": "node --env-file=.env scripts/generate-api-types.mjs",
    "format": "oxfmt --write \"**/*.{js,jsx,ts,tsx,mjs}\" \"!**/generated/**\"",
    "format-check": "oxfmt --check \"**/*.{js,jsx,ts,tsx,mjs}\" \"!**/generated/**\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "motion": "^12.42.2",
    "openapi-fetch": "^0.17.0",
    "oxfmt": "^0.57.0",
    "react": "^19.2.8",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "react-social-icons": "^6.26.0",
    "rehype-raw": "^7.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vite": "^8.1.5"
  }
}
